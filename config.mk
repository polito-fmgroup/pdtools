# config.mk - shared build configuration for pdtools
#
# Included by the top-level Makefile and by pdtrav/Makefile. It selects the
# compilers and the build mode, and defines the flags handed down to the
# vendored libraries (CUDD, Lingeling), which keep their own build systems.
#
# A setting is taken from the first of these that defines it:
#   1. the make command line     make BUILD_MODE=debug
#   2. config.local.mk           written by ./configure
#   3. the defaults in this file

# Per-machine settings generated by ./configure (optional). It is included
# first so that the `?=` defaults below only apply to what it leaves unset.
-include $(dir $(lastword $(MAKEFILE_LIST)))config.local.mk

# Build mode:
#   default    the upstream build: pdtrav with -g and no optimisation,
#              CUDD and Lingeling optimised with -O6
#   debug      debug builds throughout
#   sanitize   AddressSanitizer
#
# pdtrav's own sources are deliberately not optimised. Built with -O6 (this
# is what upstream's PDTOPT=1 does), pdtrav fails the assertion in
# Ddi_VarAttachAuxid (ddiVar.c) on several models when compiled with GCC 13.
BUILD_MODE ?= default

# Compilers.
#   TOOLCHAIN_CC   C compiler    (CUDD, ABC, AIGER, Lingeling)
#   TOOLCHAIN_CXX  C++ compiler  (pdtrav, ABC, MiniSat); also used to link
#
# The TOOLCHAIN_ prefix is intentional. GNU Make predefines CC and CXX, so
# `CC ?= gcc` would never take effect and `ifdef CC` would always be true.
#
# CXX_STD is forwarded to CUDD only: pdtrav/Makefile sets -std=c++14 for
# pdtrav's own sources, so changing CXX_STD does not affect them.
TOOLCHAIN_CC  ?= gcc
TOOLCHAIN_CXX ?= g++
CXX_STD       ?= c++14

WARN_FLAGS = -Wall

# Settings that depend on the build mode:
#   OPT_FLAGS        optimisation / debug flags for pdtrav's own sources
#   CUDD_OPT_FLAGS   the same for CUDD
#   MINISAT22LIB     MiniSat 2.2 build target (minisat22d is the debug build)
#   LGL_BUILD_FLAGS  CFLAGS passed to the Lingeling build
#   LDFLAGS          extra link flags
ifeq ($(BUILD_MODE),default)
  OPT_FLAGS      = -g
  CUDD_OPT_FLAGS = -O6
  MINISAT22LIB   = minisat22
  LGL_BUILD_FLAGS = -Wall -O6 -DNLGLOG -DNCHKSOL -DNLGLDRUPLIG -DNLGLYALSAT -DNLGLFILES -DNLGLDEMA
  LDFLAGS        =
else ifeq ($(BUILD_MODE),debug)
  OPT_FLAGS      = -g
  CUDD_OPT_FLAGS = -g
  MINISAT22LIB   = minisat22d
  LGL_BUILD_FLAGS = -Wall -g -DNLGLOG -DNCHKSOL -DNLGLDRUPLIG -DNLGLYALSAT -DNLGLFILES -DNLGLDEMA
  LDFLAGS        =
else ifeq ($(BUILD_MODE),sanitize)
  OPT_FLAGS      = -g -fsanitize=address
  CUDD_OPT_FLAGS = -g -fsanitize=address
  MINISAT22LIB   = minisat22
  LGL_BUILD_FLAGS = -Wall -O6 -DNLGLOG -DNCHKSOL -DNLGLDRUPLIG -DNLGLYALSAT -DNLGLFILES -DNLGLDEMA
  LDFLAGS        = -fsanitize=address -static-libasan
else
  $(error Unknown BUILD_MODE '$(BUILD_MODE)': use default, debug or sanitize. \
          If it comes from config.local.mk, re-run ./configure)
endif

# Extra architecture flags for CUDD and pdtrav. Empty by default so the
# binaries run on any x86-64 machine, which matters for containers and
# for anything that is distributed. For a build tuned to this host:
#   make ARCH_FLAGS="-mtune=native -malign-double"
ARCH_FLAGS ?=

# Flags forwarded to CUDD's Makefile as ICFLAGS and XCFLAGS. XCFLAGS is also
# added to pdtrav's own CFLAGS, because pdtrav includes CUDD's headers.
#
# The SIZEOF_* macros are required on a 64-bit host. CUDD assumes 4-byte
# pointers when they are undefined and then truncates pointers to 32 bits,
# which makes pdtrav crash on any BDD-based run.
CUDD_ICFLAGS = $(CUDD_OPT_FLAGS) $(WARN_FLAGS) -fPIE -pthread -std=$(CXX_STD)
CUDD_XCFLAGS = -ffloat-store $(ARCH_FLAGS) -DHAVE_IEEE_754 -DBSD \
               -DSIZEOF_VOID_P=8 -DSIZEOF_LONG=8 -DSIZEOF_INT=4

# Programs checked by `make check-deps`. The readline and zlib headers are
# probed separately by that target.
REQUIRED_TOOLS = $(TOOLCHAIN_CC) $(TOOLCHAIN_CXX) make flex bison
